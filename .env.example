# ---- core
APP_ENV=development                      # development | test | production (production enforces APP_MASTER_KEY, HTTPS provider URLs, secure cookies)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
REDIS_URL=redis://127.0.0.1:6379         # reserved for multi-node session routing / rate limits
PORT=3000
NODE_ID=node-1                           # identifies the gateway node owning a session (sticky routing)

# ---- security (generate: openssl rand -base64 32). REQUIRED in production, never commit real values.
APP_MASTER_KEY=
SESSION_COOKIE_NAME=webssh_session
SESSION_TTL_SECONDS=43200
ALLOWED_ORIGINS=http://localhost:3000    # comma separated; Host header match is always accepted
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15

# ---- terminal gateway
MAX_TERMINAL_MESSAGE_BYTES=65536
MAX_SESSIONS_PER_USER=20
MAX_SESSIONS_PER_NODE=500
TERMINAL_IDLE_TIMEOUT_SECONDS=1800
APPROVAL_TTL_SECONDS=900
TOOL_OUTPUT_MAX_BYTES=32768

# ---- LLM provider gateway
PROVIDER_ALLOW_HTTP=false                # dev default true; production must stay false
PROVIDER_ALLOW_PRIVATE_HOSTS=false       # allow RFC1918/localhost base URLs (e.g. on-prem vLLM). Cloud metadata IPs stay blocked.

# ---- mock services (development / CI only)
MOCK_SSH_ENABLED=true
MOCK_SSH_PORT=2222
MOCK_SSH_USER=demo
MOCK_SSH_PASSWORD=demo-password
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
SEED_DEV_PASSWORD=ChangeMe-Dev-2026
NEXT_PUBLIC_SHOW_DEMO_HINT=true
